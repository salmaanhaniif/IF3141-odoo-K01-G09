<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_fnb" model="ir.module.category">
        <field name="name">SaaS F&amp;B</field>
        <field name="sequence">25</field>
    </record>

    <!-- Pelayan/Kasir: CRUD pemesanan, reservasi, konfig meja, komplain -->
    <record id="group_fnb_pelayan" model="res.groups">
        <field name="name">Pelayan/Kasir</field>
        <field name="category_id" ref="saas_fnb.module_category_fnb"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Staf Dapur: Read-only pemesanan, Read-only master menu -->
    <record id="group_fnb_dapur" model="res.groups">
        <field name="name">Staf Dapur</field>
        <field name="category_id" ref="saas_fnb.module_category_fnb"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Staf Gudang: CRUD inventaris bahan baku -->
    <record id="group_fnb_gudang" model="res.groups">
        <field name="name">Staf Gudang</field>
        <field name="category_id" ref="saas_fnb.module_category_fnb"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Staf Marketing: CRUD reservasi, CRUD pelanggan -->
    <record id="group_fnb_marketing" model="res.groups">
        <field name="name">Staf Marketing</field>
        <field name="category_id" ref="saas_fnb.module_category_fnb"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Manajer: Read-only pemesanan, CRUD komplain, CRUD master menu -->
    <record id="group_fnb_manajer" model="res.groups">
        <field name="name">Manajer</field>
        <field name="category_id" ref="saas_fnb.module_category_fnb"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Admin F&B -->
    <record id="group_fnb_admin" model="res.groups">
        <field name="name">Admin F&amp;B</field>
        <field name="category_id" ref="saas_fnb.module_category_fnb"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Assign admin group to base admin user -->
    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[(4, ref('saas_fnb.group_fnb_admin'))]"/>
    </record>

    <!-- Demo Users -->
    <record id="user_fnb_pelayan" model="res.users">
        <field name="name">User Pelayan/Kasir</field>
        <field name="login">pelayan</field>
        <field name="password">pelayan123</field>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_user'), ref('saas_fnb.group_fnb_pelayan')])]"/>
    </record>

    <record id="user_fnb_dapur" model="res.users">
        <field name="name">User Staf Dapur</field>
        <field name="login">dapur</field>
        <field name="password">dapur123</field>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_user'), ref('saas_fnb.group_fnb_dapur')])]"/>
    </record>

    <record id="user_fnb_gudang" model="res.users">
        <field name="name">User Staf Gudang</field>
        <field name="login">gudang</field>
        <field name="password">gudang123</field>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_user'), ref('saas_fnb.group_fnb_gudang')])]"/>
    </record>

    <record id="user_fnb_marketing" model="res.users">
        <field name="name">User Staf Marketing</field>
        <field name="login">marketing</field>
        <field name="password">marketing123</field>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_user'), ref('saas_fnb.group_fnb_marketing')])]"/>
    </record>

    <record id="user_fnb_manajer" model="res.users">
        <field name="name">User Manajer</field>
        <field name="login">manajer</field>
        <field name="password">manajer123</field>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_user'), ref('saas_fnb.group_fnb_manajer')])]"/>
    </record>

    <record id="user_fnb_admin" model="res.users">
        <field name="name">User Admin F&amp;B</field>
        <field name="login">admin_fnb</field>
        <field name="password">admin_fnb123</field>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_user'), ref('saas_fnb.group_fnb_admin')])]"/>
    </record>
</odoo>
