<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!-- Pelayan/Kasir: CRUD pemesanan, reservasi, konfig meja, komplain, read-only master menu -->
    <record id="feature_access_pelayan" model="fnb.feature.access">
        <field name="group_id" ref="saas_fnb.group_fnb_pelayan"/>
        <field name="access_order">True</field>
        <field name="access_reservation">True</field>
        <field name="access_table">True</field>
        <field name="access_complaint">True</field>
        <field name="access_master_menu">True</field>
    </record>

    <!-- Staf Dapur: Read-only pemesanan, Read-only master menu -->
    <record id="feature_access_dapur" model="fnb.feature.access">
        <field name="group_id" ref="saas_fnb.group_fnb_dapur"/>
        <field name="access_order">True</field>
        <field name="access_master_menu">True</field>
    </record>

    <!-- Staf Gudang: CRUD inventaris bahan baku -->
    <record id="feature_access_gudang" model="fnb.feature.access">
        <field name="group_id" ref="saas_fnb.group_fnb_gudang"/>
        <field name="access_inventory">True</field>
    </record>

    <!-- Staf Marketing: CRUD reservasi, CRUD komplain -->
    <record id="feature_access_marketing" model="fnb.feature.access">
        <field name="group_id" ref="saas_fnb.group_fnb_marketing"/>
        <field name="access_reservation">True</field>
        <field name="access_complaint">True</field>
    </record>

    <!-- Manajer: Read-only pemesanan, CRUD komplain, CRUD master menu -->
    <record id="feature_access_manajer" model="fnb.feature.access">
        <field name="group_id" ref="saas_fnb.group_fnb_manajer"/>
        <field name="access_order">True</field>
        <field name="access_complaint">True</field>
        <field name="access_master_menu">True</field>
    </record>
</odoo>
